{
  "name": "ireader",
  "private": true,
  "version": "1.0.1",
  "description": "IReader - 离线本地漫画 PDF 阅读器",
  "author": "IReader",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc && vite build && electron-builder",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "postinstall": "electron-rebuild -f -w better-sqlite3"
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "pdfjs-dist": "^4.10.38",
    "pinia": "^4.0.3",
    "vue": "^3.4.21",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.1",
    "@types/better-sqlite3": "^9.6.0",
    "@vitejs/plugin-vue": "^5.0.4",
    "electron": "^42.11.12",
    "electron-builder": "^24.13.3",
    "typescript": "^5.2.2",
    "vite": "^5.1.6",
    "vite-plugin-electron": "^0.28.6",
    "vite-plugin-electron-renderer": "^0.14.5",
    "vitest": "^1.6.1",
    "vue-tsc": "^2.0.26"
  },
  "main": "dist-electron/main.js",
  "build": {
    "appId": "com.ireader.reader",
    "productName": "IReader",
    "directories": {
      "buildResources": "build",
      "output": "release/${version}"
    },
    "files": [
      "dist/**",
      "dist-electron/**"
    ],
    "asarUnpack": [
      "**/node_modules/better-sqlite3/**"
    ],
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.books",
      "identity": null,
      "artifactName": "IReader-${version}-mac.${ext}"
    },
    "dmg": {
      "title": "IReader ${version}"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "IReader-${version}-win.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
